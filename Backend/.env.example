# MongoDB connection string (replace with your Atlas or local URI)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/kuebasah?retryWrites=true&w=majority

# JWT secret for auth
JWT_SECRET=your_jwt_secret_here

# Uploads directory (relative to repo root). Backend will save uploaded files here.
UPLOAD_DIR=../Frontend/public/uploads

# Optional: set the app host/port
HOST=0.0.0.0
PORT=8000
